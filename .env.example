# =============================================================================
# Calles Seguras Juárez — Plantilla de variables de entorno
# -----------------------------------------------------------------------------
# Copia este archivo como `.env` (ya está en .gitignore) y reemplaza los valores.
# TODOS los valores de aquí son FICTICIOS. Nunca subas un `.env` real al repo.
# =============================================================================

# -----------------------------------------------------------------------------
# Base de datos (PostgreSQL) — usado por el contenedor `db` de docker-compose
# -----------------------------------------------------------------------------
POSTGRES_DB=calles_seguras
POSTGRES_USER=csj_app
# Ficticio: cámbialo por una contraseña larga y aleatoria.
POSTGRES_PASSWORD=cambia_esta_contrasena_local

# Cadena de conexión SQLAlchemy 2.0 (driver psycopg 3). En docker-compose el host es `db`;
# fuera de Docker usa `localhost`. Debe coincidir con las variables POSTGRES_* de arriba.
DATABASE_URL=postgresql+psycopg://csj_app:cambia_esta_contrasena_local@db:5432/calles_seguras

# -----------------------------------------------------------------------------
# Backend (FastAPI)
# -----------------------------------------------------------------------------
# Entorno de ejecución: development | production. En production se desactivan /docs y /openapi.json.
APP_ENV=development

# Clave para firmar los JWT. Genera una propia con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# El backend se niega a arrancar en production si conserva este valor de ejemplo.
JWT_SECRET_KEY=valor-ficticio-reemplazar-por-una-clave-aleatoria-de-64-caracteres
# Algoritmo de firma del JWT.
JWT_ALGORITHM=HS256
# Expiración por inactividad (minutos). El frontend renueva el token mientras haya actividad.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Único origen permitido por CORS (sin diagonal final). Debe ser la URL del frontend.
FRONTEND_URL=http://localhost:5173

# Zona horaria oficial para mostrar y calcular fechas (RN-02). Los datos se guardan en UTC.
APP_TIMEZONE=America/Ciudad_Juarez

# -----------------------------------------------------------------------------
# Clima (proveedor externo, consultado sólo por el backend)
# -----------------------------------------------------------------------------
# Endpoint de pronóstico. Open-Meteo no requiere llave de API.
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
# Minutos que se reutiliza la respuesta guardada en la tabla cache_clima.
WEATHER_CACHE_TTL_MINUTES=30
# Segundos máximos de espera al proveedor antes de usar la caché.
WEATHER_TIMEOUT_SECONDS=5

# -----------------------------------------------------------------------------
# Geocodificación (LocationIQ) — SÓLO BACKEND
# El frontend busca direcciones a través de GET /api/v1/geocoding/buscar;
# nunca llama a LocationIQ directamente. NO crees una variante VITE_ de estas
# variables ni las pases al servicio/imagen `frontend`: quedarían públicas en el bundle.
# -----------------------------------------------------------------------------
# URL base de la API de LocationIQ (región EE. UU.). El backend agrega /search.
GEOCODING_API_URL=https://us1.locationiq.com/v1
# Llave de API de LocationIQ (secreto). Obtén la tuya en el panel de LocationIQ.
# Si queda vacía o es inválida, el buscador usa el catálogo local de colonias (fallback).
GEOCODING_API_KEY=reemplazar_con_api_key_locationiq
# Segundos máximos de espera a LocationIQ antes de usar el fallback.
GEOCODING_TIMEOUT_SECONDS=5

# -----------------------------------------------------------------------------
# Arranque con Docker (docker compose up --build)
# -----------------------------------------------------------------------------
# Puertos publicados en tu máquina. Si cambias FRONTEND_PORT, ajusta también FRONTEND_URL (CORS).
BACKEND_PORT=8000
DB_PORT=5432
FRONTEND_PORT=5173
# true = el backend carga los datos semilla (idempotentes) al iniciar. Usa false en producción.
RUN_SEED=true
# Contraseña ficticia de las cuentas de prueba (coordinador@ejemplo.mx, moderador@ejemplo.mx,
# ciudadano01@ejemplo.mx ... ciudadano12@ejemplo.mx). Mínimo 8 caracteres con letras y números.
SEED_PASSWORD=Juarez2026

# -----------------------------------------------------------------------------
# Frontend (Vite) — sólo las variables con prefijo VITE_ llegan al navegador.
# ¡No pongas secretos en variables VITE_!
# -----------------------------------------------------------------------------
# URL base de la API SIN el prefijo /api/v1 (el cliente lo antepone a cada ruta).
# Se usa con `npm run dev`; en Docker, docker-compose.yml la deriva de BACKEND_PORT.
VITE_API_BASE_URL=http://localhost:8000
